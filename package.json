{
  "name": "dsh-music-player",
  "version": "0.7.3",
  "description": "DeepSeek Harness 音乐 + AI 讲书插件：Vibe coding人工作时的伴侣",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "LICENSE",
    "README.md"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "music",
    "player",
    "audio",
    "tts",
    "novel",
    "book"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kendu76/dsh-music-player.git"
  },
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "ci": "vitest run --retry=2 --testTimeout=20000"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "react": "^18.2.0"
  },
  "devDependencies": {
    "jsdom": "^24.1.3",
    "react-dom": "^18.3.1",
    "vitest": "^4.1.10"
  }
}
